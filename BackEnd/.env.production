# =============================================================================
# ENVIRONMENT IDENTIFIER
# =============================================================================
# Set this to "production" so your app can load production-specific settings.
ENV=production

# =============================================================================
# FRONTEND URL CONFIGURATION
# =============================================================================
# The live frontend domain of BukCare (Cloudflare Pages or your domain)
FRONTEND_URL=https://bukcare.com

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
# The main domain where users access the frontend
DOMAIN=bukcare.com
# The API domain hosted in AWS Lambda or API Gateway
API_DOMAIN=api.bukcare.com

# =============================================================================
# DATABASE CONFIGURATION (AWS RDS PostgreSQL)
# =============================================================================
# PostgreSQL database name
DATABASE_NAME=bukcare
# PostgreSQL database username
DATABASE_USER=daemon
# PostgreSQL database password (store securely in AWS Secrets Manager later)
DATABASE_PASSWORD=kenetwork24
# AWS RDS endpoint (not including the protocol)
DATABASE_HOST=postgres-db-instance.c1y4g2ius78i.ap-southeast-1.rds.amazonaws.com
# PostgreSQL port
DATABASE_PORT=5432
DATABASE_URL=postgresql+psycopg2://daemon:kenetwork24@postgres-db-instance.c1y4g2ius78i.ap-southeast-1.rds.amazonaws.com:5432/bukcare

# =============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# =============================================================================
# Gmail address used for sending notifications and OTPs
EMAIL_HOST_USER=bukcare.app@gmail.com
# Gmail App Password (never your actual password)
EMAIL_HOST_PASSWORD=nqpf cvph atbk lias
# Default sender email for FastAPI Mail or similar libraries
DEFAULT_FROM_EMAIL=bukcare.app@gmail.com

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
# Google OAuth credentials for user authentication
GOOGLE_CLIENT_ID=22514845152-v461s1o2mcv95o54bi7emaqh1buusdot.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
# Production redirect URL — must match the OAuth consent screen in Google Cloud
OAUTH_REDIRECT_URI=https://api.bukcare.com/api/v1/auth/google/callback

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================
# Secret key used for signing JWT access tokens
JWT_SECRET_KEY=KlK4KTpMNpvKjwmu-GjCQ5JAEUea-BScLBGLvLw25Qw
# Secret key for refresh tokens (should differ from above)
JWT_REFRESH_SECRET_KEY=rWw-IvgL_HXi8zXavfMd9o7QsHcgO8Uy8qrjfVW2kes
# Algorithm for JWT signing (HS256 is standard)
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (default 60)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# Refresh token lifetime in days (default 7)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Domains allowed to access the API
CORS_ALLOWED_ORIGINS=["https://bukcare.com"]
# Domains allowed to be served by FastAPI
ALLOWED_HOSTS=["bukcare.com","*.bukcare.com"]

# =============================================================================
